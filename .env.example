# Copy this file to .env and fill in your own values. Never commit .env.

# Databricks
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# SQL Server (local Docker)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=

# Market data
TIINGO_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT="brokerage-data-platform <your-email>"

# PII tokenisation (HMAC secret)
PII_HMAC_SALT=
